// Dominio TurnoSmart. B coordina cambios de schema y migraciones (ver docs/architecture.md).
// Si el repo del equipo ya tiene schema y migraciones, aquel es la fuente de verdad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReminderChannel {
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model Business {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  timezone          String             @default("America/Argentina/Buenos_Aires")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  profiles          Profile[]
  customers         Customer[]
  services          Service[]
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]
  riskScores        RiskScore[]
  reminders         Reminder[]

  @@map("businesses")
}

/// id coincide con auth.users.id de Supabase.
model Profile {
  id         String   @id @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  fullName   String?  @map("full_name")
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("profiles")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  fullName     String        @map("full_name")
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([id, businessId])
  @@index([businessId, fullName])
  @@map("customers")
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  name            String
  durationMinutes Int           @map("duration_minutes")
  priceCents      Int           @default(0) @map("price_cents")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@map("services")
}

model AvailabilityRule {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  startTime  DateTime @map("start_time") @db.Time(0)
  endTime    DateTime @map("end_time") @db.Time(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
  @@map("availability_rules")
}

model Appointment {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @map("business_id") @db.Uuid
  customerId String             @map("customer_id") @db.Uuid
  serviceId  String             @map("service_id") @db.Uuid
  startsAt   DateTime           @map("starts_at") @db.Timestamptz
  endsAt     DateTime           @map("ends_at") @db.Timestamptz
  status     AppointmentStatus  @default(SCHEDULED)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId, businessId], references: [id, businessId])
  service    Service            @relation(fields: [serviceId, businessId], references: [id, businessId])
  events     AppointmentEvent[]
  riskScore  RiskScore?
  reminders  Reminder[]

  @@unique([id, businessId])
  @@index([businessId, startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id            String             @id @default(uuid()) @db.Uuid
  businessId    String             @map("business_id") @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  type          String
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus? @map("to_status")
  actorId       String?            @map("actor_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment        @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

model RiskScore {
  id            String      @id @default(uuid()) @db.Uuid
  businessId    String      @map("business_id") @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  score         Int
  level         RiskLevel
  factors       Json
  calculatedAt  DateTime    @default(now()) @map("calculated_at") @db.Timestamptz
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([appointmentId, businessId])
  @@map("risk_scores")
}

model Reminder {
  id            String          @id @default(uuid()) @db.Uuid
  businessId    String          @map("business_id") @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  channel       ReminderChannel @default(EMAIL)
  scheduledFor  DateTime        @map("scheduled_for") @db.Timestamptz
  status        ReminderStatus  @default(PENDING)
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment     @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@map("reminders")
}
