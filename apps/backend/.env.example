# Copiar a apps/backend/.env. Nunca commitear valores reales.
NODE_ENV=development
PORT=4000

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# Supabase local (supabase start) o proyecto Free de demo.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Runtime (pooler) y migraciones (conexión directa).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Gemini: sólo en backend. Sin clave, el endpoint de explicación responde 503 AI_UNAVAILABLE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_OUTPUT_TOKENS=400
# Límite de explicaciones por usuario por ventana.
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_WINDOW_MS=3600000
